# Copy to .env and fill in. Never commit .env.

# PostgreSQL document store (optional — omit to use in-memory fallback)
# Format: postgresql://user:password@host/dbname
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres/ragdb

# LLM used for Phase 1 fallback agent
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Azure Document Intelligence (Managed Identity auth - no key needed)
# Format: https://<resource-name>.cognitiveservices.azure.com/
AZURE_DOCINT_ENDPOINT=

# Azure OpenAI (powers the /api/recommend LLM recommender; falls back to the
# rules engine when unset). Format: https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Provider credentials (only needed when the matching provider is selected)
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_BLOB_CONNECTION_STRING=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

GOOGLE_APPLICATION_CREDENTIALS=

PINECONE_API_KEY=
WEAVIATE_URL=
WEAVIATE_API_KEY=
COHERE_API_KEY=

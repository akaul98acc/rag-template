from google.cloud import documentai


_client = documentai.DocumentProcessorServiceClient()


def extract_text(processor_name: str, file_bytes: bytes, mime_type: str = "application/pdf") -> str:
    raw_doc = documentai.RawDocument(content=file_bytes, mime_type=mime_type)
    request = documentai.ProcessRequest(name=processor_name, raw_document=raw_doc)
    result = _client.process_document(request=request)
    return result.document.text

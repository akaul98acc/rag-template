from pinecone import Pinecone
import os

_pc = Pinecone(api_key=os.environ["PINECONE_API_KEY"])
_index = _pc.Index("rag-index")


def upsert(ids: list[str], vectors: list[list[float]], metadatas: list[dict]) -> None:
    _index.upsert(vectors=list(zip(ids, vectors, metadatas)))


def search(query_vector: list[float], top_k: int = 5) -> list[dict]:
    res = _index.query(vector=query_vector, top_k=top_k, include_metadata=True)
    return [{"id": m.id, "score": m.score, "metadata": m.metadata} for m in res.matches]

import faiss
import numpy as np

_dim = 1536
_index = faiss.IndexFlatIP(_dim)
_metadata: list[dict] = []


def upsert(vectors: list[list[float]], metadatas: list[dict]) -> None:
    arr = np.array(vectors, dtype="float32")
    faiss.normalize_L2(arr)
    _index.add(arr)
    _metadata.extend(metadatas)


def search(query_vector: list[float], top_k: int = 5) -> list[dict]:
    q = np.array([query_vector], dtype="float32")
    faiss.normalize_L2(q)
    scores, idx = _index.search(q, top_k)
    return [{"score": float(s), "metadata": _metadata[i]} for s, i in zip(scores[0], idx[0]) if i != -1]

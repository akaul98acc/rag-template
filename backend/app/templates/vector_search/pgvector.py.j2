import psycopg
import os

_conn = psycopg.connect(os.environ["DATABASE_URL"], autocommit=True)


def init_db(embedding_dimensions: int = 3072) -> None:
    with _conn.cursor() as cur:
        cur.execute("CREATE EXTENSION IF NOT EXISTS vector")
        cur.execute(
            f"CREATE TABLE IF NOT EXISTS rag_chunks ("
            f"    id TEXT PRIMARY KEY,"
            f"    content TEXT NOT NULL,"
            f"    source TEXT,"
            f"    chunk_index INTEGER DEFAULT 0,"
            f"    embedding vector({embedding_dimensions})"
            f")"
        )


def upsert(docs: list[dict]) -> None:
    # Each dict must contain: id (str), content (str), source (str), embedding (list[float])
    with _conn.cursor() as cur:
        for d in docs:
            cur.execute(
                "INSERT INTO rag_chunks (id, content, source, chunk_index, embedding) VALUES (%s, %s, %s, %s, %s) "
                "ON CONFLICT (id) DO UPDATE SET content = EXCLUDED.content, source = EXCLUDED.source, chunk_index = EXCLUDED.chunk_index, embedding = EXCLUDED.embedding",
                (d["id"], d["content"], d["source"], d.get("chunk_index", 0), d["embedding"]),
            )


def search(query_vector: list[float], top_k: int = 5) -> list[dict]:
    with _conn.cursor() as cur:
        cur.execute(
            "SELECT id, content, source, chunk_index, 1 - (embedding <=> %s::vector) AS score "
            "FROM rag_chunks ORDER BY score DESC LIMIT %s",
            (query_vector, top_k),
        )
        return [{"id": r[0], "content": r[1], "source": r[2], "chunk_index": r[3], "score": float(r[4])} for r in cur.fetchall()]

from openai import AzureOpenAI
import os

_client = AzureOpenAI(
    api_key=os.environ["AZURE_OPENAI_KEY"],
    azure_endpoint=os.environ["AZURE_OPENAI_ENDPOINT"],
    api_version="2024-06-01",
)

_DEPLOYMENT = "{{ params.embedding_model if params is defined else 'text-embedding-3-large' }}"
_DIMENSIONS = {{ params.embedding_dims if params is defined else 3072 }}


def embed(texts: list[str], deployment: str = _DEPLOYMENT) -> list[list[float]]:
    resp = _client.embeddings.create(model=deployment, input=texts)
    return [d.embedding for d in resp.data]


def embed_query(text: str) -> list[float]:
    return embed([text], deployment=_DEPLOYMENT)[0]
